# mask_low.sg —— 位运算 / 移位 / 短路条件(grammer.md §3 类型、§5 表达式、§6.3 条件跳转)
#
# 每个 lane 处理一个字(32 位):
#   偶数下标 ⇒ out = (in & 0xFF) | 0x80    保留低 8 位、高位置 0x80(用 andi/ori 的立即形式)
#   奇数下标 ⇒ out = in >>> 1              逻辑右移(srli;`>>` 是算术右移 srai, 符号位扩展)
#   越界下标, 或读到的字恰好是 0 ⇒ 整条 lane 跳过(不写回)
#
# 条件是 `A || B`:短路求值 —— 左边成立就不再算右边(§6.3)。

const -: 0x02000000

kernel mask_low
    var base, N, idx, addr, v

    param base : int @const[0]
    param N    : int @const[4]

    idx  = tid() + wid() * 8
    addr = base + idx * 4
    v    = ldx(addr)

    when (idx >= N) || (v == 0) goto done

    if (idx & 1) == 0:
        v = (v & 255) | 128
    else:
        v = v >>> 1
    end

    stx(addr, v)

done:
    exit
end
